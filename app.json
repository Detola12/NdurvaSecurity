{
  "expo": {
    "name": "Ndurva Security",
    "slug": "ndurva-security-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "ndurvasecurity",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D0D0D"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ndurva.security",
      "infoPlist": {
        "NSCameraUsageDescription": "Ndurva Security uses the camera to scan resident and visitor codes at the gate."
      }
    },
    "android": {
      "package": "com.ndurva.security",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D0D0D"
      },
      "permissions": ["android.permission.CAMERA"],
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Ndurva Security uses the camera to scan resident and visitor codes at the gate."
        }
      ]
    ],
    "experiments": { "typedRoutes": true }
  }
}
